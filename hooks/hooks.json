{
  "description": "File each plan you approve as a private Sumibako page, and start a session with the project's recent pages. Both exit quietly until npx sumibako is connected.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline sumibako hook claude-code",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline sumibako brief --hook claude-code",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
